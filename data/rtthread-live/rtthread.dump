80000f1c <time_in_secs>:

secs_ret time_in_secs(CORE_TICKS ticks)
{
    /* A valid CoreMark run is 10--100 s, below the 32-bit wrap point at 50 MHz. */
    return (secs_ret)((ee_u32)ticks / BSP_CPU_HZ);
}
